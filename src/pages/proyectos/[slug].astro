---
import { Image } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import ArrowLeft from '@gravity-ui/icons/svgs/arrow-left.svg';
import ArrowUpRight from '@gravity-ui/icons/svgs/arrow-up-right.svg';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const Logo = project.logo;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={project.description} />
    <meta name="theme-color" content="#FBF3E7" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=editorial" />
    <title>{project.name} — Verónica · Diseño gráfico</title>
    <ClientRouter />
  </head>
  <body class="project-page" style={`--project-color: ${project.color}; --project-ink: ${project.ink}; --panel-ink: ${project.panelInk}; --logo-ink: ${project.logoInk ?? "#FBF3E7"};`}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <section class="project-intro paper-texture">
        <a class="back-link" href="/#proyectos"><ArrowLeft width="17" height="17" aria-hidden="true" /> Volver a proyectos</a>
        <div class="project-heading">
          <div><p class="eyebrow">{project.category}</p><h1>{project.name}</h1></div>
          <p class="project-tagline">{project.title}</p>
        </div>
        <div class="project-cover" transition:name={`${project.slug}-cover`}>
          <Image src={project.cover} alt={project.coverAlt} widths={[480, 800, 1200, Math.min(1800, project.cover.width)]} sizes="90vw" format="webp" quality={84} loading="eager" fetchpriority="high" />
        </div>
      </section>
      <section class="project-story paper-texture">
        <div class="story-copy" data-reveal><h2>{project.storyLead}<br /><em>{project.storyTitle}</em></h2><p>{project.description}</p></div>
        <dl data-reveal>
          <div><dt>Mi participación</dt><dd>{project.role}</dd></div>
          {project.collaborators && <div><dt>Colaboración</dt><dd>{project.collaborators}</dd></div>}
          <div><dt>Herramientas</dt><dd>{project.software}</dd></div>
        </dl>
      </section>
      <section class="brand-panel">
        <div class="brand-panel__logo" data-reveal><Logo aria-label={`Logotipo de ${project.name}`} role="img" /></div>
        <div class="brand-panel__copy" data-reveal><h2>{project.conceptLead}<br />{project.conceptTitle}</h2><p>{project.concept}</p></div>
      </section>
      <section class="project-gallery paper-texture" aria-labelledby="applications-title">
        <h2 id="applications-title" data-reveal>{project.galleryLead} <em>{project.galleryTitle}</em></h2>
        <div class="gallery-grid">
          {project.gallery.map(item => (
            <figure class:list={['gallery-item', { 'gallery-item--wide': item.wide }]} data-reveal>
              <Image src={item.image} alt={item.alt} widths={[...new Set([480, 800, 1200, Math.min(1800, item.image.width)].filter(width => width <= item.image.width))]} sizes={item.wide ? '90vw' : '(max-width: 700px) 90vw, 44vw'} format="webp" quality={84} loading="lazy" />
              <figcaption>{item.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
      <footer class="project-footer paper-texture"><a href="/#proyectos"><ArrowLeft width="20" height="20" aria-hidden="true" /> Volver a proyectos</a><a href="/#contacto">Conversemos <ArrowUpRight width="20" height="20" aria-hidden="true" /></a></footer>
    </main>
    <script>import '../../scripts/animations';</script>
  </body>
</html>
<style>
  .project-page { background: var(--cream); color: var(--ink); }
  .project-page :global(.site-header) { color: var(--project-ink); }
  .project-intro, .project-story, .project-gallery, .project-footer { position: relative; background-color: var(--cream); padding-inline: var(--page-gutter); }
  .project-intro { padding-top: 140px; padding-bottom: 70px; }
  .back-link { display: inline-flex; align-items: center; gap: 10px; font-size: 12px; color: var(--project-ink); }
  .project-heading { display: flex; justify-content: space-between; align-items: end; gap: 36px; margin: 45px 0 40px; }
  h1 { font: 500 clamp(54px, 7.5vw, 112px)/.95 var(--font-editorial); letter-spacing: -.045em; color: var(--project-ink); margin: 14px 0 0; }
  .project-tagline { font: italic 500 clamp(24px, 2.5vw, 38px)/1.1 var(--font-editorial); max-width: 250px; margin: 0; color: var(--project-ink); }
  .project-cover { height: auto; aspect-ratio: 1672 / 941; overflow: hidden; border-radius: 24px; background: #eee9e3; }
  .project-cover img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .project-story { display: grid; grid-template-columns: 1.15fr 1fr; gap: 12%; padding-block: 20px 100px; }
  h2 { font: 500 clamp(42px, 4.5vw, 68px)/1 var(--font-editorial); letter-spacing: -.025em; margin: 0 0 28px; color: var(--project-ink); }
  h2 em { font-weight: inherit; }
  p, dd { font-size: 15px; line-height: 1.8; }
  .story-copy { max-width: 640px; }
  dl { margin: 0; padding-top: 6px; }
  dl > div { border-top: 1px solid color-mix(in srgb, var(--project-color) 19%, transparent); padding-block: 20px; }
  dt { color: var(--project-ink); font-size: 12px; font-weight: 600; }
  dd { margin: 10px 0 0; }
  .brand-panel { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 14%; padding: 100px var(--page-gutter); background: var(--project-color); color: var(--panel-ink); }
  .brand-panel__logo :global(svg) { color: var(--logo-ink); display: block; width: min(100%, 380px); height: auto; fill: currentColor; margin: auto; }
  .brand-panel h2 { color: inherit; }
  .brand-panel__copy { max-width: 450px; }
  .project-gallery { padding-block: 100px 70px; }
  .gallery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px 28px; }
  figure { margin: 0; }
  .gallery-item--wide { grid-column: 1 / -1; }
  .gallery-item img { display: block; width: 100%; height: auto; border-radius: 24px; }
  figcaption { margin-top: 14px; font-size: 12px; color: var(--muted); }
  .project-footer { display: flex; justify-content: space-between; gap: 24px; padding-block: 32px 48px; border-top: 1px solid color-mix(in srgb, var(--project-color) 19%, transparent); color: var(--project-ink); }
  .project-footer a { display: inline-flex; align-items: center; gap: 12px; font-size: 14px; }
  @media (min-width: 1700px) { .project-intro, .project-story, .project-gallery, .project-footer, .brand-panel { padding-inline: max(var(--page-gutter), calc((100vw - 1500px) / 2)); } }
  @media (max-width: 700px) { .project-intro { padding-top: 112px; padding-bottom: 48px; } .project-heading { flex-direction: column; align-items: start; gap: 22px; margin-top: 30px; } .project-tagline { max-width: none; } .project-cover { height: auto; min-height: 0; aspect-ratio: 1672 / 941; } .project-story, .brand-panel { grid-template-columns: 1fr; gap: 38px; padding-block: 40px 56px; } .brand-panel__logo :global(svg) { max-width: 240px; } .project-gallery { padding-block: 56px; } .gallery-grid { grid-template-columns: 1fr; gap: 30px; } .project-footer { flex-wrap: wrap; } }
</style>
