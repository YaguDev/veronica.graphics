---
import Photoshop from '../assets/icons/photoshop.svg';
import Illustrator from '../assets/icons/illustrator.svg';
import InDesign from '../assets/icons/indesign.svg';
import Procreate from '../assets/icons/procreate.svg';
import Instagram from '../assets/icons/instagram.svg';
import Behance from '../assets/icons/behance.svg';
import Correo from '../assets/icons/correo.svg';
const icons = { Photoshop, Illustrator, InDesign, Procreate, Instagram, Behance, Correo };
interface Props { name: keyof typeof icons; size?: number; }
const { name, size = 20 } = Astro.props;
const Icon = icons[name];
---
<Icon width={size} height={size} fill="currentColor" aria-hidden="true" focusable="false" />
