---
import { i18n } from '../i18n';
const { lang, t, home, projectPath } = i18n(Astro.url);
import { Image } from 'astro:assets';
import ArrowUpRight from '@gravity-ui/icons/svgs/arrow-up-right.svg';
import { getProjects } from '../data/projects';
const projects = getProjects(lang);
const groups = [
  { id: 'identidad-visual', title: 'Identidad Visual', slugs: ['riva', 'amaranto', 'bubble-bug', 'sereia'] },
  { id: 'diseno-editorial', title: 'Diseño Editorial', slugs: ['ellas', 'sinapsia', 'dolus-divinus'] },
  { id: 'juegos', title: 'Juegos', slugs: ['entre-pasadizos', 'camino-a-la-esperanza'] },
].map(group => {
  const items = group.slugs.map(slug => projects.find(project => project.slug === slug)!);
  return { ...group, items, columns: items.filter(project => !project.featured).length % 2 === 1 ? 3 : 2 };
});
---
<section class="projects paper-texture" id="proyectos" aria-labelledby="projects-title">
  <div class="projects__inner">
    <div class="section-caption"><span>{t("02 / Proyectos")}</span><span>{t("Una selección personal")}</span></div>
    <h2 id="projects-title">{t("Ideas que")} <em>{t("toman forma.")}</em></h2>
    {groups.map(group => (
    <section class="projects__group" aria-labelledby={group.id}>
    <h3 class="projects__category" id={group.id}>{t(group.title)}</h3>
    <div class="projects__grid" style={`--columns: ${group.columns};`}>
      {group.items.map(project => (
        <a class:list={["project-card", { "project-card--featured": project.featured }]} href={projectPath(project.slug)} aria-label={`${t("Ver proyecto")} ${project.name}`}>
          <div class="project-card__image" transition:name={`${project.slug}-cover`}>
            <Image src={project.cover} alt={project.coverAlt} widths={[480, 800, 1200, Math.min(1800, project.cover.width)]} sizes={project.featured || projects.length === 1 ? '90vw' : `(max-width: 700px) 90vw, (max-width: 1000px) 44vw, ${group.columns === 3 ? '29vw' : '44vw'}`} format="webp" quality={84} loading="lazy" />
          </div>
          <div class="project-card__info">
            <div><h4>{project.name}</h4><p>{project.category}</p></div>
            <span class="project-card__arrow" aria-hidden="true"><ArrowUpRight width="26" height="26" /></span>
          </div>
        </a>
      ))}
    </div>
    </section>
    ))}
  </div>
</section>
<style>
  .projects { background-color: var(--red); color: var(--cream); padding: 100px var(--page-gutter); --paper-opacity: .52; }
  .projects__inner { max-width: 1400px; margin-inline: auto; }
  h2 { font: 400 clamp(52px, 6vw, 90px)/1 var(--font-heading); letter-spacing: -.04em; margin: 40px 0 48px; }
  h2 em { font-weight: inherit; }
  .projects__group + .projects__group { margin-top: 88px; }
  .projects__category { border-top: 1px solid rgb(251 243 231 / .45); padding-top: 24px; margin: 0 0 32px; font: 400 clamp(28px, 3vw, 42px)/1.1 var(--font-heading); }
  .project-card--featured .project-card__image { aspect-ratio: 2.8 / 1; }
  .project-card--featured .project-card__image img { object-fit: cover; object-position: center; }
  .projects__grid { display: grid; grid-template-columns: repeat(var(--columns), minmax(0, 1fr)); gap: 48px 32px; }
  .project-card:only-child, .project-card--featured { grid-column: 1 / -1; }
  .project-card__image { height: auto; aspect-ratio: 1672 / 941; overflow: hidden; border-radius: 24px; background: #eee9e3; }
  .project-card__image img { display: block; width: 100%; height: 100%; object-fit: contain; transition: transform .6s ease; }
  .project-card:hover img { transform: scale(1.035); }
  .project-card__info { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 4px 0; }
  h4 { font: 400 clamp(30px, 3vw, 44px)/1.1 var(--font-heading); margin: 0; }
  .project-card__info p { margin: 9px 0 0; font-size: 12px; }
  .project-card__arrow { display: grid; place-items: center; border: 1px solid currentColor; border-radius: 50%; width: 52px; height: 52px; flex-shrink: 0; }
  @media (min-width: 701px) and (max-width: 1000px) { .projects__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) { .project-card--featured .project-card__image { aspect-ratio: 2 / 1; } .projects__group + .projects__group { margin-top: 56px; } .projects { padding-block: 74px 64px; } .projects__grid { grid-template-columns: 1fr; } .section-caption span:last-child { display: none; } h2 { margin-block: 32px; } .project-card__image { height: auto; aspect-ratio: 1672 / 941; } }
</style>
