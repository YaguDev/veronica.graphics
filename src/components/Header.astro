---
import ArrowUpRight from '@gravity-ui/icons/svgs/arrow-up-right.svg';
---
<header class="site-header">
  <a class="brand" href="#inicio" aria-label="Verónica — Inicio">Verónica<span aria-hidden="true">.</span></a>
  <nav aria-label="Navegación principal">
    <a href="#sobre-mi">Sobre mí</a>
    <a href="#proyectos">Proyectos</a>
    <a href="#contacto">Contacto <ArrowUpRight width="13" height="13" aria-hidden="true" /></a>
  </nav>
</header>
<style>
  .site-header { position: absolute; z-index: 10; inset: 0 0 auto; display: flex; align-items: center; justify-content: space-between; min-height: 100px; padding: 20px var(--page-gutter); color: var(--cream); }
  .brand { font: 500 36px/1 var(--font-editorial); letter-spacing: -.05em; }
  nav { display: flex; align-items: center; gap: clamp(24px, 3.5vw, 56px); }
  nav a { font-size: 14px; padding-block: 12px; }
  nav a :global(svg) { vertical-align: middle; }
  nav a::after { content: ''; display: block; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .25s ease; }
  nav a:hover::after, nav a:focus-visible::after { transform: scaleX(1); }
  @media (max-width: 600px) {
    .site-header { min-height: 86px; gap: 14px; padding-block: 16px; }
    .brand { font-size: 29px; }
    nav { gap: 16px; }
    nav a { font-size: 12px; }
  }
  @media (max-width: 360px) { .brand { font-size: 25px; } nav { gap: 11px; } nav a { font-size: 11px; } }
</style>
