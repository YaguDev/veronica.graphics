---
import { i18n } from '../i18n';
import Play from '@gravity-ui/icons/svgs/play-fill.svg';
import Xmark from '@gravity-ui/icons/svgs/xmark.svg';
const { t } = i18n(Astro.url);
---
<video-presentation>
  <button class="video-trigger" type="button" aria-haspopup="dialog" aria-controls="presentation-dialog">
    <span class="video-trigger__icon"><Play width="17" height="17" aria-hidden="true" /></span>
    {t('Ver Reel')}
  </button>
  <dialog id="presentation-dialog" aria-labelledby="presentation-title">
    <div class="video-header">
      <h2 id="presentation-title">{t('Presentación de Verónica')}</h2>
      <button class="video-close" type="button" aria-label={t('Cerrar video')} autofocus><Xmark width="24" height="24" aria-hidden="true" /></button>
    </div>
    <video controls playsinline preload="none" data-src="/videos/presentacion-final.mp4" aria-label={t('Presentación de Verónica')}>
      {t('Tu navegador no admite la reproducción de este video.')}
    </video>
  </dialog>
</video-presentation>
<script>
  class VideoPresentation extends HTMLElement {
    cleanup?: () => void;
    connectedCallback() {
      const trigger = this.querySelector<HTMLButtonElement>('.video-trigger')!;
      const dialog = this.querySelector('dialog')!;
      // Astro replaces media nodes during a page swap; resolve the live element on each action.
      const currentVideo = () => this.querySelector('video')!;
      const listeners = new AbortController();
      const options = { signal: listeners.signal };
      let previousOverflow = '';
      const restore = () => {
        currentVideo().pause();
        document.documentElement.style.overflow = previousOverflow;
      };
      trigger.addEventListener('click', () => {
        previousOverflow = document.documentElement.style.overflow;
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
        const video = currentVideo();
        if (!video.getAttribute('src')) video.src = video.dataset.src!;
        void video.play().catch(() => { /* Native controls remain available if autoplay is blocked. */ });
      }, options);
      this.querySelector('.video-close')!.addEventListener('click', () => dialog.close(), options);
      dialog.addEventListener('click', event => {
        const box = dialog.getBoundingClientRect();
        if (event.target === dialog && (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom)) dialog.close();
      }, options);
      dialog.addEventListener('close', restore, options);
      const stop = () => { if (dialog.open) { dialog.close(); restore(); } };
      document.addEventListener('astro:before-swap', stop, options);
      this.cleanup = () => { stop(); listeners.abort(); currentVideo().pause(); };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('video-presentation')) customElements.define('video-presentation', VideoPresentation);
</script>
<style>
  video-presentation { display: block; }
  button { cursor: pointer; font: inherit; color: inherit; }
  .video-trigger { display: inline-flex; align-items: center; gap: 12px; border: 1px solid rgb(251 243 231 / .65); background: transparent; border-radius: 999px; padding: 12px 20px; min-height: 48px; font-size: 13px; transition: background .2s, color .2s; }
  .video-trigger:hover { background: var(--cream); color: var(--red); }
  .video-trigger__icon { display: flex; }
  dialog { width: min(1000px, calc(100vw - 32px)); max-height: 90svh; padding: 0; border: 1px solid rgb(251 243 231 / .25); border-radius: 20px; background: #171717; color: var(--cream); overflow: auto; }
  dialog::backdrop { background: rgb(0 0 0 / .8); }
  .video-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 20px; }
  h2 { font: 400 clamp(22px, 3vw, 30px)/1.2 var(--font-heading); margin: 0; }
  .video-close { display: grid; place-items: center; width: 44px; height: 44px; flex-shrink: 0; border: 1px solid currentColor; border-radius: 50%; background: transparent; }
  video { display: block; width: 100%; max-height: calc(90svh - 80px); background: #000; }
  @media (max-width: 600px) { .video-trigger { padding: 10px 14px; font-size: 12px; gap: 8px; } }
</style>
