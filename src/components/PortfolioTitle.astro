---
import { i18n } from '../i18n';
const { lang, t, home, projectPath } = i18n(Astro.url);
import SpanishWordmark from '../assets/botanical/portafolio.svg';
import EnglishWordmark from '../assets/botanical/portfolio-en.svg';
const Wordmark = lang === "en" ? EnglishWordmark : SpanishWordmark;
---
<h1 class="portfolio-title" id="hero-title" aria-label={t("Portafolio de Verónica, diseñadora gráfica")}>
  <Wordmark class="portfolio-title__art" aria-hidden="true" focusable="false" />
</h1>
<style>
  .portfolio-title { position: relative; margin: 0 auto; width: min(88%, 960px); }
  .portfolio-title :global(svg) { display: block; width: 100%; height: auto; overflow: visible; fill: currentColor; }
</style>
