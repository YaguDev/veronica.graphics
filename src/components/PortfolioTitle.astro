---
import Wordmark from '../assets/botanical/portafolio.svg';
---
<h1 class="portfolio-title" id="hero-title" aria-label="Portafolio de Verónica, diseñadora gráfica">
  <Wordmark class="portfolio-title__art" aria-hidden="true" focusable="false" />
</h1>
<style>
  .portfolio-title { position: relative; margin: 0 auto; width: min(88%, 960px); }
  .portfolio-title :global(svg) { display: block; width: 100%; height: auto; overflow: visible; fill: currentColor; }
</style>
