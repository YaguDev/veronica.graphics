---
import { i18n } from '../i18n';
const { lang, t, home, projectPath } = i18n(Astro.url);
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import LanguageLinks from './LanguageLinks.astro';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import paperUrl from '../assets/textures/paper.webp?url';
import displayFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={t("Soy Verónica, diseñadora gráfica. Identidad visual, ilustración y diseño editorial: una mirada sensible, ideas con identidad.")} />
    <meta name="theme-color" content="#E84533" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=editorial" />
    <link rel="icon" href="/favicon.ico?v=editorial" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=editorial" sizes="180x180" />
    <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
    <link rel="preload" as="image" href={paperUrl} />
    <title>{t("Verónica — Diseño gráfico & Portafolio")}</title>
    <ClientRouter />
    <LanguageLinks />
    <script is:inline>
      // Fail open if the animation bundle cannot load.
      (() => {
        let seen = false;
        try { seen = sessionStorage.getItem('veronica-editorial-intro-v1') === 'seen'; } catch {}
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const deepLink = location.hash && location.hash !== '#inicio';
        if (!seen && !reduced && !deepLink) {
          document.documentElement.setAttribute('data-intro-pending', '');
          window.setTimeout(() => {
            if (document.documentElement.hasAttribute('data-intro-pending')) {
              document.documentElement.removeAttribute('data-intro-pending');
              document.querySelectorAll('[data-page-content]').forEach(el => el.removeAttribute('inert'));
              document.dispatchEvent(new Event('portfolio:intro-timeout'));
            }
          }, 6000);
        }
      })();
    </script>
  </head>
  <body>
    <Loader />
    <div data-page-content>
      <a class="skip-link" href="#contenido">{t("Saltar al contenido")}</a>
      <Header />
      <main id="contenido" tabindex="-1">
        <Hero />
        <About />
        <Projects />
      </main>
      <Contact />
    </div>
    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
