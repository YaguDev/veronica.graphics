---
import { i18n } from '../i18n';
const { lang } = i18n(Astro.url);
const en = lang === 'en';
const fields = [
  ['firstName', en ? 'First name' : 'Nombre', 'text', 'given-name', 80],
  ['lastName', en ? 'Last name' : 'Apellidos', 'text', 'family-name', 80],
  ['email', en ? 'Email' : 'Correo electrónico', 'email', 'email', 254],
  ['phone', en ? 'Phone' : 'Teléfono', 'tel', 'tel', 40],
];
---
<contact-modal data-lang={lang}>
  <dialog aria-labelledby="contact-title">
    <button class="close" type="button" aria-label={en ? 'Close' : 'Cerrar'}>×</button>
    <h2 id="contact-title">{en ? 'Let’s talk' : 'Conversemos'}</h2>
    <p>{en ? 'Tell me about your idea.' : 'Cuéntame qué tienes en mente.'}</p>
    <form>
      <div class="fields">
        {fields.map(([name, label, type, autocomplete, max]) => <label>{label}<input name={name} type={type} autocomplete={autocomplete} maxlength={max} required /></label>)}
      </div>
      <label>{en ? 'What would you like to create?' : '¿Qué te gustaría crear?'}<textarea name="message" rows="4" maxlength="5000" required></textarea></label>
      <div data-turnstile></div>
      <p class="status" role="status" aria-live="polite"></p>
      <button class="send button-outline" type="submit" disabled>{en ? 'Send message' : 'Enviar mensaje'} <span aria-hidden="true">↗</span></button>
    </form>
  </dialog>
</contact-modal>
<script>
  import '../scripts/contact-modal';
</script>
<style>
  dialog { margin: auto; width: min(640px, calc(100vw - 32px)); max-height: 90svh; overflow: auto; padding: clamp(24px, 5vw, 48px); border: 1px solid var(--red); border-radius: 24px; background: var(--cream); color: var(--ink); }
  dialog::backdrop { background: rgb(30 20 16 / .65); backdrop-filter: blur(5px); }
  h2 { margin: 0 32px 10px 0; font: 400 clamp(36px, 5vw, 52px)/1.1 var(--font-heading); color: var(--red-ink); }
  p { font-size: 14px; }
  .close { position: absolute; right: 18px; top: 12px; background: none; border: 0; font-size: 32px; cursor: pointer; color: var(--red-ink); }
  form { margin-top: 24px; display: grid; gap: 18px; }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  label { display: grid; gap: 8px; font-size: 13px; }
  input, textarea { width: 100%; min-width: 0; padding: 12px; border: 1px solid #b9aaa1; border-radius: 8px; background: #fff9; color: var(--ink); font: inherit; }
  textarea { resize: vertical; }
  input:focus-visible, textarea:focus-visible { outline: 2px solid var(--red-ink); outline-offset: 2px; }
  .send { justify-self: start; color: var(--red-ink); background: transparent; cursor: pointer; }
  .send:disabled { opacity: .5; cursor: not-allowed; }
  .status { margin: 0; }
  .status:empty { display: none; }
  @media(max-width: 480px) { .fields { grid-template-columns: 1fr; } }
</style>
