---
import { Image } from 'astro:assets';
import portrait from '../assets/hero/veronica.webp';
import Pencil from '@gravity-ui/icons/svgs/pencil.svg';
import ArrowUpRight from '@gravity-ui/icons/svgs/arrow-up-right.svg';
const tools = [
  { symbol: 'Ai', name: 'Illustrator' },
  { symbol: 'Ps', name: 'Photoshop' },
  { symbol: null, name: 'Ilustración digital' },
  { symbol: 'Id', name: 'InDesign' },
];
---
<section class="about paper-texture" id="sobre-mi" aria-labelledby="about-title">
  <div class="section-caption"><span>01 / Sobre mí</span><span>La persona detrás de las ideas</span></div>
  <div class="about__sheet">
    <div class="about__portrait-column">
      <div class="about__hello" data-reveal><h2 id="about-title">¡Hola!</h2><p>Soy Verónica</p></div>
      <div class="about__portrait" data-portrait>
        <Image src={portrait} alt="Verónica, diseñadora gráfica" widths={[360, 640, 960]} sizes="(max-width: 700px) 85vw, (max-width: 1100px) 42vw, 460px" format="webp" loading="eager" decoding="async" />
      </div>
    </div>
    <div class="about__story">
      <div data-reveal>
        <h3>Sobre mí</h3>
        <p>Soy Verónica, diseñadora gráfica enfocada en crear piezas visuales con identidad, funcionalidad y criterio gráfico.</p>
        <p>Tengo experiencia desarrollando piezas para redes sociales, catálogos, estampados y edición fotográfica. Me interesa especialmente seguir creciendo en identidad visual, branding y diseño editorial.</p>
      </div>
      <div class="about__education" data-reveal>
        <h3>Educación</h3>
        <div class="education-entry"><span class="education-entry__date">2023 — 2026</span><p>Estudiante de Diseño Gráfico<br /><span>Institución Universitaria Pascual Bravo</span></p></div>
        <div class="education-entry"><span class="education-entry__date">2012</span><p>Técnico en Pre-prensa Digital<br /><span>SENA</span></p></div>
      </div>
    </div>
    <div class="about__skills" data-reveal>
      <h3>Herramientas</h3>
      <ul>{tools.map(({ symbol, name }) => (<li><span class="tool-mark" aria-hidden="true">{symbol || <Pencil width="27" height="27" />}</span><span>{name}</span></li>))}</ul>
    </div>
    <div class="about__socials" data-reveal>
      <a href="#">Behance <ArrowUpRight width="14" height="14" aria-hidden="true" /></a>
      <a href="#">Instagram <ArrowUpRight width="14" height="14" aria-hidden="true" /></a>
      <a href="#">Correo <ArrowUpRight width="14" height="14" aria-hidden="true" /></a>
    </div>
  </div>
  <div class="about__paper-edge paper-texture" aria-hidden="true"></div>
</section>
<style>
  .about { position: relative; z-index: 2; padding: 42px var(--page-gutter) 78px; background-color: var(--cream); --paper-opacity: .45; }
  .section-caption { max-width: 1400px; margin: 0 auto 28px; }
  .about__sheet { position: relative; display: grid; grid-template-columns: 39% minmax(0, 1fr) 18%; column-gap: 4%; max-width: 1400px; min-height: 640px; margin-inline: auto; padding: 45px 40px 30px 24px; border: 1.5px solid var(--red); border-radius: 4px 34px 4px 34px; }
  .about__portrait-column { position: relative; grid-row: 1 / 3; min-width: 0; }
  .about__hello { position: relative; z-index: 2; padding-left: 26px; }
  .about__hello h2 { margin: 0; color: var(--red); font: 500 clamp(68px, 7.5vw, 112px)/.9 var(--font-editorial); letter-spacing: -.04em; }
  .about__hello p { margin: 8px 0 0 46px; font: italic 500 clamp(30px, 3.5vw, 48px)/1.1 var(--font-editorial); transform: rotate(-5deg); }
  .about__portrait { position: absolute; width: calc(100% + 16px); max-width: 365px; bottom: -78px; left: 50%; transform: translateX(-50%); }
  .about__portrait img { display: block; width: 100%; height: auto; }
  .about__story, .about__skills { padding-top: 12px; }
  h3 { font: 500 36px/1.1 var(--font-editorial); letter-spacing: -.025em; color: var(--red); margin: 0 0 18px; }
  .about__story p { font-size: 14px; line-height: 1.7; margin: 0 0 12px; }
  .about__education { margin-top: 30px; }
  .education-entry { margin-top: 16px; }
  .education-entry__date { display: block; font-size: 10px; font-weight: 600; color: var(--red-ink); letter-spacing: .12em; margin-bottom: 6px; }
  .education-entry p { font-size: 12px; line-height: 1.6; }
  .education-entry p span { color: var(--muted); }
  .about__skills h3 { font-size: 30px; }
  .about__skills ul { display: flex; flex-direction: column; gap: 20px; list-style: none; padding: 0; margin: 24px 0 0; }
  .about__skills li { display: flex; align-items: center; gap: 12px; font-size: 11px; line-height: 1.4; }
  .tool-mark { width: 47px; height: 47px; flex-shrink: 0; border-radius: 11px; background: var(--red); color: var(--cream); display: grid; place-items: center; font-size: 26px; font-weight: 650; letter-spacing: -.04em; }
  .about__socials { grid-column: 2 / 4; display: flex; flex-wrap: wrap; gap: 28px; align-self: end; padding-top: 26px; margin-top: 12px; border-top: 1px solid rgb(232 69 51 / .3); }
  .about__socials a { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; color: var(--red-ink); }
  .about__socials a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .about__paper-edge { position: absolute; left: 0; right: 0; bottom: -31px; height: 34px; background-color: var(--cream); mask-image: url('../assets/textures/paper-edge.svg'); mask-size: 100% 100%; mask-repeat: no-repeat; }
  @media (max-width: 1100px) and (min-width: 701px) {
    .about__sheet { grid-template-columns: 44% 1fr; padding-right: 28px; gap: 0 5%; min-height: 680px; }
    .about__portrait-column { grid-row: 1 / 4; }
    .about__skills { grid-column: 2; padding: 18px 0; }
    .about__skills h3 { font-size: 26px; margin-bottom: 12px; }
    .about__skills ul { flex-direction: row; gap: 16px; margin-top: 0; flex-wrap: wrap; }
    .about__skills li { flex-direction: column; gap: 6px; width: 54px; font-size: 9px; text-align: center; }
    .tool-mark { width: 40px; height: 40px; font-size: 23px; }
    .about__socials { grid-column: 2; gap: 18px; }
  }
  @media (max-width: 700px) {
    .about { padding: 28px 20px 42px; }
    .section-caption { margin-bottom: 20px; }
    .section-caption span:last-child { display: none; }
    .about__sheet { grid-template-columns: 1fr; padding: 30px 24px 26px; border-radius: 4px 28px 4px 28px; }
    .about__portrait-column { grid-row: auto; min-height: 510px; overflow: clip; margin: 0 -24px 28px; }
    .about__hello { padding-left: 28px; }
    .about__hello h2 { font-size: 84px; }
    .about__hello p { font-size: 36px; margin-left: 42px; }
    .about__portrait { width: 85%; max-width: 300px; left: 50%; bottom: -36px; transform: translateX(-50%); }
    .about__story, .about__skills { padding-top: 0; }
    .about__skills { margin-top: 24px; }
    .about__skills ul { flex-direction: row; flex-wrap: wrap; gap: 20px; }
    .about__skills li { flex-direction: column; width: 50px; font-size: 10px; text-align: center; }
    .about__socials { grid-column: 1; gap: 24px; margin-top: 28px; padding-top: 24px; }
    h3 { font-size: 36px; }
  }
  @media (max-width: 360px) { .about__portrait-column { min-height: 460px; } .about__skills ul { gap: 14px; } .about__socials { gap: 16px; } }
</style>
