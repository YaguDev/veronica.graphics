---
import ArrowDown from '@gravity-ui/icons/svgs/arrow-down.svg';
import PortfolioTitle from './PortfolioTitle.astro';
import flowerLeft from '../assets/botanical/Flor-001.webp';
import flowerRight from '../assets/botanical/Flor-004.webp';
import leaves from '../assets/botanical/Hojas-001.webp';
import topLeaves from '../assets/botanical/Hojas-002.webp';
---
<section class="hero paper-texture" id="inicio" aria-labelledby="hero-title">
  <div class="hero__frame" aria-hidden="true"></div>
  <div class="hero__artwork" aria-hidden="true">
    <div class="hero__botanical hero__botanical--top" data-botanical="top"><img src={topLeaves.src} width={topLeaves.width} height={topLeaves.height} alt="" decoding="async" /></div>
    <div class="hero__botanical hero__botanical--left" data-botanical="left"><img src={flowerLeft.src} width={flowerLeft.width} height={flowerLeft.height} alt="" decoding="async" /></div>
    <div class="hero__botanical hero__botanical--right" data-botanical="right"><img src={flowerRight.src} width={flowerRight.width} height={flowerRight.height} alt="" decoding="async" /></div>
    <div class="hero__botanical hero__botanical--leaves" data-botanical="right"><img src={leaves.src} width={leaves.width} height={leaves.height} alt="" decoding="async" /></div>
  </div>
  <div class="hero__center">
    <p class="eyebrow hero__eyebrow" data-intro-item>Una mirada sensible. Ideas con identidad.</p>
    <PortfolioTitle />
    <p class="hero__discipline" data-intro-item>Diseño gráfico</p>
  </div>
  <div class="hero__bottom" data-intro-item>
    <span class="hero__note">El diseño también<br />es una forma de sentir.</span>
    <a class="hero__scroll" href="#sobre-mi"><span>Conóceme</span><span class="hero__arrow"><ArrowDown width="18" height="18" aria-hidden="true" /></span></a>
    <span class="hero__edition">Portafolio personal<br />Verónica · Diseño gráfico</span>
  </div>
</section>
<style>
  .hero { position: relative; display: flex; flex-direction: column; justify-content: center; min-height: 650px; height: 90svh; max-height: 1050px; padding: 130px var(--page-gutter) 140px; background-color: var(--red); color: var(--cream); overflow: clip; --paper-opacity: .52; }
  .hero__frame { position: absolute; inset: 100px 20px 20px; border: 1px solid rgb(251 243 231 / .35); pointer-events: none; border-radius: 20px;}
  .hero__center { position: relative; width: 100%; max-width: 1500px; margin-inline: auto; text-align: center; }
  .hero__eyebrow { margin: 0 0 32px; }
  .hero__discipline { margin: clamp(42px, 4vw, 64px) 0 0; font-size: clamp(13px, 1.25vw, 18px); letter-spacing: .4em; text-transform: uppercase; }
  .hero__artwork { position: absolute; inset: 0; pointer-events: none; }
  .hero__botanical { position: absolute; opacity: .48; }
  .hero__botanical img { display: block; width: 100%; height: auto; }
  .hero__botanical--top { width: clamp(170px, 15vw, 240px); left: 24%; top: -220px; opacity: .38; }
  .hero__botanical--top img { transform: rotate(125deg); }
  .hero__botanical--left { width: clamp(240px, 28vw, 460px); left: -6%; bottom: -15%; }
  .hero__botanical--left img { transform: rotate(24deg); }
  .hero__botanical--right { width: clamp(255px, 30vw, 490px); right: -6%; top: 12%; opacity: .42; }
  .hero__botanical--right img { transform: rotate(-22deg); }
  .hero__botanical--leaves { width: clamp(190px, 21vw, 340px); right: 17%; bottom: -17%; opacity: .32; }
  .hero__botanical--leaves img { transform: rotate(-30deg); }
  .hero__bottom { position: absolute; left: var(--page-gutter); right: var(--page-gutter); bottom: 50px; display: flex; justify-content: space-between; align-items: end; gap: 24px; font-size: 12px; line-height: 1.6; }
  .hero__note { font-style: italic; }
  .hero__edition { text-align: right; }
  .hero__scroll { display: flex; align-items: center; gap: 14px; }
  .hero__arrow { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid rgb(251 243 231 / .6); border-radius: 50%; transition: background .25s, color .25s; }
  .hero__scroll:hover .hero__arrow { background: var(--cream); color: var(--red); }
  @media (min-width: 1800px) { .hero__frame { inset-inline: 32px; } }
  @media (max-width: 600px) {
    .hero { height: 80svh; min-height: 520px; max-height: 740px; padding: 120px 24px 140px; }
    .hero__frame { inset: 86px 10px 12px; }
    .hero__eyebrow { max-width: 240px; margin: 0 auto 28px; font-size: 10px; line-height: 1.8; }
    .hero__discipline { font-size: 12px; letter-spacing: .3em; margin-top: 28px; }
    .hero__bottom { bottom: 36px; font-size: 10px; }
    .hero__edition { display: none; }
    .hero__scroll { gap: 10px; font-size: 12px; }
    .hero__botanical--left { width: 190px; left: -90px; bottom: -25px; opacity: .38; }
    .hero__botanical--right { width: 205px; right: -90px; top: 90px; opacity: .35; }
    .hero__botanical--leaves { display: none; }
    .hero__botanical--top { display: none; }
  }
</style>
